---
import { changeLanguage, t } from "i18next";
import { localizePath } from "astro-i18next";
import Layout from "../layouts/Layout.astro";
import AuraLight from "../components/AuraLight.astro";
import Header from "../sections/Header.astro";
import Footer from "../sections/Footer.astro";

changeLanguage("en");
---

<Layout title={t("meta.notFound.title")} description={t("meta.notFound.description")} noindex>
  <AuraLight />
  <div class="content">
    <Header />
    <main id="main" class="not-found">
      <h1 class="not-found__code accent">{t("notFound.code")}</h1>
      <p class="not-found__text">{t("notFound.text")}</p>
      <a class="not-found__back" href={localizePath("/")}>← {t("notFound.back")}</a>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 65dvh;
    text-align: center;
  }

  .not-found__code {
    margin: 0;
    font-size: 4.5rem;
    letter-spacing: -0.04em;
  }

  .not-found__text {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  .not-found__back {
    margin-top: 16px;
    padding: 8px 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    transition: background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);

    &:hover {
      background-color: var(--surface-hover);
      border-color: var(--accent);
    }

    &:active {
      transform: translateY(1px);
    }
  }
</style>
