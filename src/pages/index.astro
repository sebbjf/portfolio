---
import { changeLanguage, t } from "i18next";
import Layout from "../layouts/Layout.astro";
import AuraLight from "../components/AuraLight.astro";
import AboutMe from "../sections/AboutMe.astro";
import Header from "../sections/Header.astro";
import Footer from "../sections/Footer.astro";
import Skills from "../sections/Skills.astro";
import Experience from "../sections/Experience.astro";
import Education from "../sections/Education.astro";
import Awards from "../sections/Awards.astro";
import Projects from "../sections/Projects.astro";
import Contact from "../sections/Contact.astro";

changeLanguage("en");
---

<Layout title={t("meta.home.title")} description={t("meta.home.description")}>
  <AuraLight />
  <div class="content">
    <Header />
    <main id="main">
      <AboutMe />
      <Skills />
      <Experience />
      <Education />
      <Awards />
      <Projects />
      <Contact />
    </main>
    <Footer />
  </div>
</Layout>
