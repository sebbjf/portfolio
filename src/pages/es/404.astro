---
import { useTranslations, localizePath } from "../../utils/i18n";
import Layout from "../../layouts/Layout.astro";
import AuraLight from "../../components/AuraLight.astro";
import Header from "../../sections/Header.astro";
import Footer from "../../sections/Footer.astro";

const t = useTranslations(Astro.currentLocale);
---

<Layout title={t("meta.notFound.title")} description={t("meta.notFound.description")} noindex>
  <AuraLight />
  <div class="content">
    <Header />
    <main id="main" class="not-found">
      <h1 class="not-found__code accent" data-reveal>{t("notFound.code")}</h1>
      <p class="not-found__text" data-reveal style="--i: 1">{t("notFound.text")}</p>
      <div data-reveal style="--i: 2">
        <a class="not-found__back" href={localizePath("/", Astro.currentLocale)}
        ><span class="not-found__arrow" aria-hidden="true">←</span> {t("notFound.back")}</a
      >
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 65dvh;
    text-align: center;
  }

  .not-found__code {
    margin: 0;
    font-size: 4.5rem;
    letter-spacing: -0.04em;
  }

  .not-found__text {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  /* A plain underlined link like the rest of the page; the arrow springs toward where it goes. */
  .not-found__back {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: 16px;
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out);

    &:hover {
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text-muted);
    }
  }

  .not-found__arrow {
    display: inline-block;
    margin-right: 6px;
    color: var(--text-subtle);
    transition:
      transform 0.45s var(--ease-spring),
      color 0.2s var(--ease-out);
  }

  .not-found__back:hover .not-found__arrow {
    color: currentColor;
    transform: translateX(-3px);
  }
</style>
