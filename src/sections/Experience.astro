---
import i18next, { t } from "i18next";
import experience from "../consts/experience.js";

const getDescription = (e, language) => {
  return e.translation && e.translation[language] ? e.translation[language].description : e.description;
};

const currentLanguage = i18next.language;

const formatDate = (date) => (date === "Currently" ? t("experience.currently") : date);
---

<section>
  <h2 id="experience">{t("experience.title")}</h2>
  <div class="timeline__container">
    <ul class="timeline__list">
      {
        experience.map((e) => (
          <li class={"timeline__element" + (e.startDate == "Currently" ? " timeline__element--currently" : "")}>
            <div class="timeline__main">
              <div class="timeline__title">
                <h3 class="timeline__name">{e.name}</h3>
                <div>
                  <span class="timeline__as">{t("experience.as")}</span>
                  <p class="timeline__position">{e.position}</p>
                </div>
              </div>
              <p class="timeline__date">
                {formatDate(e.startDate) + (e.endDate ? " – " + formatDate(e.endDate) : "")}
              </p>
            </div>
            <p>{getDescription(e, currentLanguage)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .timeline__list {
    margin: 0;
    border: 0 solid var(--border-strong);
    border-left-width: 1px;
    padding-left: 40px;
  }

  .timeline__element {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 12px;
    border-radius: var(--radius-md);

    > p {
      margin: 0;
      color: var(--text-muted);
    }
  }

  .timeline__element::before {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    background-color: var(--border-strong);
    border-radius: 50%;
    margin-left: -58px;
    margin-top: 10px;
  }

  .timeline__element--currently::before {
    background-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .timeline__main {
    display: flex;
    justify-content: space-between;
  }

  .timeline__title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }

  .timeline__as {
    font-size: 0.75rem;
    color: var(--text-subtle);
    margin-right: 3px;
  }

  .timeline__name {
    margin: 0;
    color: var(--text-strong);
  }

  .timeline__as,
  .timeline__position {
    display: inline;
  }

  .timeline__date {
    color: var(--text-muted);
    width: fit-content;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    border-radius: 9px;
    margin: 0;
    align-self: center;
  }

  .timeline__position {
    margin: 0;
  }

  @media only screen and (max-width: 768px) {
    .timeline__title {
      flex-direction: column;
      align-items: flex-start;
    }

    .timeline__date {
      align-self: flex-start;
      margin-top: 6px;
    }
  }

  @media only screen and (max-width: 400px) {
    .timeline__main {
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .timeline__date {
      margin: 0;
    }
  }
</style>
