---
import i18next, { t } from "i18next";
import experience from "../consts/experience.js";

const currentLanguage = i18next.language;

const localize = (e, key) => e.translation?.[currentLanguage]?.[key] ?? e[key];

// "2025-01" -> "January 2025" / "enero 2025", like the printed résumé.
const formatDate = (date) => {
  if (date === "present") return t("experience.currently");
  const [year, month] = date.split("-").map(Number);
  const monthName = new Intl.DateTimeFormat(currentLanguage, { month: "long", timeZone: "UTC" }).format(
    new Date(Date.UTC(year, month - 1)),
  );
  return `${monthName} ${year}`;
};
---

<section aria-labelledby="experience">
  <h2 id="experience">{t("experience.title")}</h2>
  <ul class="entries">
    {
      experience.map((e) => (
        <li class="entry">
          <div class="entry__head">
            <h3 class="entry__title">
              {localize(e, "position")},
              <em class="entry__org">{e.name}</em>
            </h3>
            <p class="entry__date">
              {formatDate(e.startDate) + (e.endDate ? " – " + formatDate(e.endDate) : "")}
            </p>
          </div>
          <p class="entry__description">{localize(e, "description")}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .entries {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
  }

  .entry__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 24px;
  }

  .entry__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .entry__org {
    font-weight: 400;
  }

  .entry__date {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  .entry__description {
    margin: 2px 0 0;
    color: var(--text-muted);
  }
</style>
