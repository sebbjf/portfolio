---
import i18next, { t } from "i18next";
import experience from "../consts/experience.js";

const getDescription = (e, language) => {
  return e.translation && e.translation[language] ? e.translation[language].description : e.description;
};

const currentLanguage = i18next.language;

const formatDate = (date) => (date === "Currently" ? t("experience.currently") : date);
---

<section aria-labelledby="experience">
  <h2 id="experience">{t("experience.title")}</h2>
  <ul class="entries">
    {
      experience.map((e) => (
        <li class="entry">
          <div class="entry__head">
            <h3 class="entry__title">
              {e.position},
              <em class="entry__org">{e.name}</em>
            </h3>
            <p class="entry__date">
              {formatDate(e.startDate) + (e.endDate ? " – " + formatDate(e.endDate) : "")}
            </p>
          </div>
          <p class="entry__description">{getDescription(e, currentLanguage)}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .entries {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
  }

  .entry__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 24px;
  }

  .entry__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .entry__org {
    font-weight: 400;
  }

  .entry__date {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  .entry__description {
    margin: 2px 0 0;
    color: var(--text-muted);
  }
</style>
