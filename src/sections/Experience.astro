---
import { useTranslations } from "../utils/i18n";
import experience from "../consts/experience.js";
import { formatPeriod } from "../utils/formatPeriod.js";
import "../styles/entries.css";

const t = useTranslations(Astro.currentLocale);

const currentLanguage = Astro.currentLocale;

const localize = (e, key) => e.translation?.[currentLanguage]?.[key] ?? e[key];
---

<section aria-labelledby="experience">
  <h2 id="experience" data-reveal>{t("experience.title")}</h2>
  <ul class="entries">
    {
      experience.map((e, i) => (
        <li class="entry" data-reveal style={`--i: ${i}`}>
          <div class="entry__head">
            <h3 class="entry__title">{localize(e, "position")}</h3>
            <p class="entry__date">
              {formatPeriod(e.startDate, e.endDate, currentLanguage, t("experience.currently"))}
            </p>
          </div>
          <p class="entry__org">{e.name}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .entry__org {
    margin: 0;
  }
</style>

