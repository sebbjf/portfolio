---
import { useTranslations, localizePath } from "../utils/i18n";
import LanguageSelector from "../components/LanguageSelector.astro";

const t = useTranslations(Astro.currentLocale);
---

<header class="header__container" id="header">
  <a href={localizePath("/", Astro.currentLocale)} class="header__title" aria-label="Sebastian Jamito">
    <img class="header__logo" src="/img/logo/seb-white.png" alt="" width="24" height="24" />
  </a>
  <span class="header__divider" aria-hidden="true"></span>
  <nav aria-label={t("a11y.mainNav")}>
    <ul class="header__list" id="header-navbar">
      <li class="header__indicator" aria-hidden="true"></li>
      <li><a class="header__anchor" href={localizePath("/#", Astro.currentLocale)}>{t("hero.title")}</a></li>
      <li><a class="header__anchor" href={localizePath("/#experience", Astro.currentLocale)}>{t("experience.title")}</a></li>
      <li><a class="header__anchor" href={localizePath("/#projects", Astro.currentLocale)}>{t("projects.title")}</a></li>
      <li><a class="header__anchor" href={localizePath("/#contact", Astro.currentLocale)}>{t("contact.title")}</a></li>
    </ul>
  </nav>
  <div class="header__lang"><LanguageSelector /></div>
</header>

<script>
  const $navbar = document.getElementById("header-navbar");
  const headerAnchors = document.querySelectorAll<HTMLAnchorElement>(".header__anchor");

  // One highlight slides and resizes between links: to the hovered one, else the current one.
  let hovered: HTMLAnchorElement | null = null;
  const moveIndicator = () => {
    const target = hovered ?? document.querySelector<HTMLAnchorElement>(".header__anchor[aria-current]");
    $navbar.classList.toggle("header__list--has-indicator", Boolean(target));
    if (!target) return;
    $navbar.style.setProperty("--ix", `${target.offsetLeft}px`);
    $navbar.style.setProperty("--iw", `${target.offsetWidth}px`);
  };

  headerAnchors.forEach((anchor) =>
    anchor.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      hovered = anchor;
      moveIndicator();
    }),
  );
  $navbar.addEventListener("pointerleave", () => {
    hovered = null;
    moveIndicator();
  });
  window.addEventListener("resize", moveIndicator);

  // Mark the link of the section being read: the last one whose heading has passed 40% of the
  // viewport, or the last link once the page bottom is reached (Contact may never get that high).
  const sections = [...headerAnchors]
    .map((anchor) => ({ anchor, target: document.getElementById(new URL(anchor.href).hash.slice(1) || "aboutme") }))
    .filter(({ target }) => target);

  const setCurrent = (current: HTMLAnchorElement) => {
    headerAnchors.forEach((anchor) => {
      if (anchor === current) anchor.setAttribute("aria-current", "location");
      else anchor.removeAttribute("aria-current");
    });
    moveIndicator();
  };

  const markCurrent = () => {
    if (!sections.length) return;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    let current = sections[0];
    for (const section of sections) {
      if (section.target.getBoundingClientRect().top <= window.innerHeight * 0.4) current = section;
    }
    if (atBottom) current = sections[sections.length - 1];
    setCurrent(current.anchor);
  };

  // Clicking a link: the highlight goes straight to it in one move, instead of hopping through the
  // sections the smooth scroll passes. Scrolling is ignored until it settles (no scroll event for
  // 140ms; 600ms if the page does not move at all), then the real position is checked once.
  let navigating = false;
  let settleTimer: ReturnType<typeof setTimeout>;

  const settle = (ms: number) => {
    clearTimeout(settleTimer);
    settleTimer = setTimeout(() => {
      navigating = false;
      markCurrent();
    }, ms);
  };

  headerAnchors.forEach((anchor) =>
    anchor.addEventListener("click", () => {
      navigating = true;
      setCurrent(anchor);
      settle(600);
    }),
  );

  markCurrent();
  window.addEventListener(
    "scroll",
    () => {
      if (navigating) settle(140);
      else markCurrent();
    },
    { passive: true },
  );
  // Placed without animation first (and once the font has loaded), then it glides.
  document.fonts.ready.then(() => {
    moveIndicator();
    requestAnimationFrame(() => $navbar.classList.add("header__list--ready"));
  });
</script>

<style>
  .header__container {
    position: fixed;
    top: 20px;
    left: 50%;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px;
    border: 1px solid var(--chrome-border);
    border-radius: 999px;
    background-color: var(--chrome-bg);
    box-shadow: var(--shadow-float);
    white-space: nowrap;
    translate: -50% 0;

    /* Quick fix for Chrome bug #40835530: backdrop-filter doesn't work on nested elements. */
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      backdrop-filter: blur(16px);
      z-index: -1;
      border-radius: inherit;
    }
  }

  .header__title {
    display: block;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .header__logo {
    width: 24px;
    display: block;
  }

  .header__divider {
    width: 1px;
    height: 18px;
    margin-inline: 4px;
    background-color: var(--border);
  }

  .header__list {
    position: relative;
    display: flex;
    gap: 2px;
    align-items: center;
    margin: 0;
  }

  /* Sits behind the links (they are positioned, it comes first) and springs between them. */
  .header__indicator {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: var(--iw, 0);
    border-radius: 999px;
    background-color: var(--tint-active);
    translate: var(--ix, 0) 0;
    opacity: 0;
    pointer-events: none;
  }

  .header__list--has-indicator .header__indicator {
    opacity: 1;
  }

  .header__list--ready .header__indicator {
    transition:
      translate 0.45s var(--ease-spring),
      width 0.45s var(--ease-spring),
      opacity 0.2s var(--ease-out);
  }

  .header__lang {
    display: flex;
    align-items: center;
    padding-left: 5px;
    margin-left: 4px;
    border-left: 1px solid var(--border);
  }

  .header__anchor {
    position: relative;
    display: block;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition:
      color 0.2s var(--ease-out),
      scale 0.14s var(--ease-out);

    &:hover,
    &[aria-current] {
      color: var(--text-strong);
    }

    &:active {
      scale: 0.97;
    }
  }

  /* Touch: every control in the pill gets a full-height hit area. */
  @media (pointer: coarse) {
    .header__title,
    .header__anchor {
      display: flex;
      align-items: center;
      min-height: var(--tap);
      box-sizing: border-box;
    }
  }

  /* Phones keep every link in the pill: the logo goes (About me already leads home) and the links tighten. */
  @media only screen and (max-width: 768px) {
    .header__container {
      top: max(12px, env(safe-area-inset-top));
      padding: 4px;
    }

    .header__title,
    .header__divider {
      display: none;
    }

    .header__list {
      gap: 0;
    }

    .header__anchor {
      padding: 5px 8px;
      font-size: 0.8rem;
    }

    .header__lang {
      padding-left: 2px;
      margin-left: 2px;
    }
  }

  /* The smallest phones (320px). */
  @media only screen and (max-width: 360px) {
    .header__anchor {
      padding-inline: 5px;
      font-size: 0.75rem;
    }
  }
</style>
