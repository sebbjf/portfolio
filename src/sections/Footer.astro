---
import Trans from "../components/Trans.astro";
---

<footer class="footer__container">
  <div class="footer__content">
    <div class="footer__left">
      <Trans i18nKey="footer">
        Made with <a
        href="https://astro.build/"
        target="_blank"
        aria-describedby="new-tab-hint"
        rel="noopener noreferrer"
        class="footer__link">Astro</a
      >, deployed with <a
        href="https://vercel.com/"
        target="_blank"
        aria-describedby="new-tab-hint"
        rel="noopener noreferrer"
        class="footer__link">Vercel</a
      >.
      </Trans>
    </div>
    <div class="footer__right">© {new Date().getFullYear()} · @sebbjf</div>
  </div>
</footer>

<style>
  /* A quiet bar closing the page, with no rule: the credit on the left and the year on the right. */
  .footer__container {
    margin-top: 96px;
    padding: 0 0 40px;
    color: var(--text-subtle);
    font-size: 0.85rem;
    font-style: italic;
  }

  .footer__content {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    justify-content: space-between;
  }

  /* Muted until hovered, like the links in Contact. */
  .footer__link {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition:
      color 0.2s var(--ease-out),
      text-decoration-color 0.2s var(--ease-out);

    &:hover {
      color: var(--text-strong);
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text);
    }
  }
</style>
