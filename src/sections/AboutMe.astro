---
import Trans from "../components/Trans.astro";
import { useTranslations, localizePath } from "../utils/i18n";

const t = useTranslations(Astro.currentLocale);
---

<header class="hero" id="aboutme">
  <h1 class="hero__name">Sebastian Jamito</h1>
  <p class="hero__role">{t("hero.role")}</p>
  <a class="hero__status" href="#contact" data-flash-contact>
    <span class="hero__status-dot" aria-hidden="true"></span>
    {t("hero.availableForWork")}
  </a>
  <div class="hero__meta">
    <span>{t("hero.location")}</span>
    <span class="hero__sep" aria-hidden="true">·</span>
    <span class="hero__clock" id="hero-clock" aria-hidden="true"></span>
  </div>
  <div class="hero__links">
    <a class="hero__link" href="mailto:hi@sebastianjf.com">{t("hero.email")}</a>
    <a class="hero__link" href="https://github.com/sebbjf/" target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">github</a>
    <a class="hero__link" href={localizePath("/resume", Astro.currentLocale)} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">{t("contact.resume")}</a>
  </div>
</header>

<script>
  // Barcelona time next to the name ("10:42 AM CET"), in the clock style of the page language.
  const timeZone = "Europe/Madrid";
  const $clock = document.getElementById("hero-clock");
  const clock = new Intl.DateTimeFormat(document.documentElement.lang, { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone });
  // CET / CEST in every language (the page's own locale would print GMT+1).
  const zone = new Intl.DateTimeFormat("en-GB", { timeZone, timeZoneName: "short" });
  const update = () => {
    const abbr = zone.formatToParts(new Date()).find((p) => p.type === "timeZoneName")?.value ?? "";
    $clock.textContent = `${clock.format(new Date())} ${abbr}`;
  };
  update();
  setInterval(update, 1000);
</script>

<section class="about">
  <div class="profile">
    <p>
      <Trans i18nKey="hero.about">
        Web Application Development student at Institut TIC de Barcelona. I design interfaces and build them with
        <span class="highlight">Astro and React</span>.
      </Trans>
    </p>
    <p>
      {t("hero.projectsText")} <a class="profile__link" href="#projects">{t("hero.projectsButton")}</a>
      {t("hero.contactText")}
      <a class="profile__link profile__cta" href="#contact" data-flash-contact
        >{t("hero.contactButton")}<svg class="profile__arrow" viewBox="5 0 14 24" aria-hidden="true"
          ><path d="M12 5v14M6 13l6 6 6-6"></path></svg
        ></a
      >
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 112px 0 8px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 4px 16px;
    line-height: 1.45;
  }

  /* Identity on the left, state (availability, place and time) on the right, links below. */
  .hero__name {
    grid-area: 1 / 1;
  }

  .hero__role {
    grid-area: 2 / 1;
  }

  .hero__status {
    grid-area: 1 / 2;
  }

  .hero__meta {
    grid-area: 2 / 2;
    justify-content: flex-end;
  }

  .hero__links {
    grid-area: 3 / 1 / 4 / -1;
  }

  .hero__meta,
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 10px;
  }

  .hero__meta {
    font-size: 0.93rem;
    color: var(--text-muted);
  }

  .hero__links {
    margin-top: 14px;
    gap: 2px 18px;
    font-size: 0.93rem;
  }

  .hero__sep {
    color: var(--text-subtle);
  }

  .hero__link {
    font-weight: 500;
    color: var(--text);
    text-transform: lowercase;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out);

    &:hover {
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text-muted);
    }
  }

  .hero__clock {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Sits close under the hero: the intro belongs to the name above it. */
  .about {
    margin-top: 24px;
  }

  .hero__name {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .hero__role {
    margin: 0;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    justify-self: end;
    color: var(--text);

    &:hover {
      color: var(--text-strong);
    }

    &:active {
      color: var(--text);
    }
  }

  .hero__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--status);
    animation: pulse 1800ms infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--status);
    }
    75% {
      box-shadow: 0 0 0 6px transparent;
    }
  }

  /* Only very narrow phones stack everything; wider ones keep identity on the left and state on the right. */
  @media only screen and (max-width: 349px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__name,
    .hero__role,
    .hero__status,
    .hero__meta,
    .hero__links {
      grid-area: auto;
    }

    .hero__status {
      justify-self: start;
      margin-top: 10px;
    }

    .hero__meta {
      justify-content: flex-start;
    }
  }

  /* Touch: the tap target grows past the text without growing the row, so the stack keeps its rhythm. */
  @media (pointer: coarse) {
    .hero__link,
    .hero__status {
      position: relative;

      &::after {
        content: "";
        position: absolute;
        inset: calc((var(--tap) - 1lh) / -2) -6px;
      }
    }
  }

  .profile > p {
    margin: 0 0 0.7em;
    color: var(--text-muted);

    &:last-child {
      margin-bottom: 0;
    }
  }

  .profile__link {
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out);

    &:hover {
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text-muted);
    }
  }

  /* "Get in touch": the arrow points where the link goes, and nudges that way on hover. */
  .profile__cta {
    white-space: nowrap;
  }

  .profile__arrow {
    display: inline-block;
    width: 0.5em;
    height: 0.85em;
    margin-left: 4px;
    vertical-align: -0.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--text-subtle);
    transition:
      transform 0.45s var(--ease-spring),
      color 0.25s var(--ease-out);
  }

  .profile__cta:hover .profile__arrow,
  .profile__cta:focus-visible .profile__arrow {
    color: currentColor;
    transform: translateY(3px);
  }
</style>
