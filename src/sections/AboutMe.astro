---
import { Image } from "astro:assets";
import { t } from "i18next";
import { Trans } from "astro-i18next/components";
import LinkAnchor from "../components/LinkAnchor.astro";
import GithubIcon from "../icons/github.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import EmailIcon from "../icons/email.astro";
---

<section class="hero">
  <div id="aboutme" class="hero__name-container">
    <Image
      class="hero__avatar"
      src="https://avatars.githubusercontent.com/u/108923627?v=4"
      alt="Sebastian JF"
      width="120"
      height="120"
      loading="eager"
    />
    <div>
      <h1 class="hero__name accent">seb</h1>
      <a class="hero__undername" href="#contact"
        ><span class="pulse_dot" aria-hidden="true"></span> {t("hero.availableForWork")}</a
      >
    </div>
  </div>
  <h2 class="hero__hey accent">
    <span class="wave" aria-hidden="true">👋</span> {t("hero.hey")}
  </h2>

  <div class="hero__bio">
    <p>{t("hero.aboutme1")}</p>
    <p>
      <Trans i18nKey="hero.aboutme2">
        I build <span class="highlight">web experiences</span> focused on clarity, performance,
        and precision.
      </Trans>
    </p>
    <p>{t("hero.aboutme3")}</p>
    <p>
      {t("hero.projectsText")}
      <LinkAnchor content={t("hero.projectsButton")} to="#projects" />.
      <br />
      {t("hero.contactText")}
      <LinkAnchor content={t("hero.contactButton")} to="#contact" />!
    </p>
  </div>
  <ul class="hero__links">
    <li>
      <a class="hero__link" href="https://github.com/sebbjf/" target="_blank" rel="noopener noreferrer">
        <span class="hero__link_icon" aria-hidden="true"><GithubIcon /></span>
        GitHub
      </a>
    </li>
    <li>
      <a class="hero__link" href="mailto:hi@sebastianjf.com">
        <span class="hero__link_icon" aria-hidden="true"><EmailIcon /></span>
        hi@sebastianjf.com
      </a>
    </li>
    <li>
      <a class="hero__link" href="https://www.linkedin.com/in/sebastian-jf/" target="_blank" rel="noopener noreferrer">
        <span class="hero__link_icon" aria-hidden="true"><LinkedinIcon /></span>
        LinkedIn
      </a>
    </li>
  </ul>
</section>

<style>
  .wave {
    animation-name: wave-animation;
    animation-duration: 2.5s;
    animation-iteration-count: 3;
    transform-origin: 70% 70%;
    display: inline-block;
  }

  .wave:hover {
    animation: none;
    animation: wave-animation 2.5s infinite;
  }

  @keyframes wave-animation {
    0% {
      transform: rotate(0deg);
    }
    10% {
      transform: rotate(14deg);
    }
    20% {
      transform: rotate(-8deg);
    }
    30% {
      transform: rotate(14deg);
    }
    40% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(10deg);
    }
    60% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  .hero__name-container {
    display: flex;
    height: 200px;
    align-items: center;
    gap: 35px;
    margin-bottom: -25px;
  }

  .hero__avatar {
    border-radius: 100%;
    width: 120px;
    height: 120px;
  }

  .hero__name {
    margin-bottom: -3px;
  }

  .hero {
    margin-top: 0;
  }

  .hero__bio > p {
    margin: 0 0 1.2em;
  }

  .hero__link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    color: var(--text-strong);
    transition: background-color 0.2s var(--ease-out);

    &:hover {
      background-color: var(--surface-hover);
    }

    &:active {
      transform: translateY(1px);
    }
  }

  .hero__link_icon {
    line-height: 1;
  }

  .hero__links {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin: 40px 0 0;
    flex-wrap: wrap;
  }

  .hero__hey {
    font-size: 28px;
    margin-bottom: 8px;
  }

  .hero__undername {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    color: #c5e0ae;
    gap: 12px;
    text-wrap: nowrap;
  }

  .pulse_dot {
    height: 8px;
    width: 8px;
    display: block;
    border-radius: 50%;
    background-color: var(--status);
    animation: pulse 1500ms infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: var(--status) 0 0 0 0;
    }
    75% {
      box-shadow: transparent 0 0 0 6px;
    }
  }

  @media only screen and (max-width: 768px) {
    .hero__links {
      gap: 4px;
      justify-content: flex-start;
    }
  }
</style>
