---
import { t } from "i18next";
import { Trans } from "astro-i18next/components";
import GithubIcon from "../icons/github.astro";
// import LinkedinIcon from "../icons/linkedin.astro";
import EmailIcon from "../icons/email.astro";
---

<header class="hero" id="aboutme">
  <h1 class="hero__name">Sebastian Jamito</h1>
  <p class="hero__role">{t("hero.role")}</p>
  <ul class="hero__contact">
    <li>
      <a href="mailto:hi@sebastianjf.com">
        <EmailIcon class:list={"hero__icon"} aria-hidden="true" />
        hi@sebastianjf.com
      </a>
    </li>
    <li>
      <a href="https://github.com/sebbjf/" target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
        <GithubIcon class:list={"hero__icon"} viewBox="0 0 30 30" aria-hidden="true" />
        sebbjf
      </a>
    </li>
    {/* <li>
      <a href="https://www.linkedin.com/in/sebastian-jf/" target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
        <LinkedinIcon class:list={"hero__icon"} aria-hidden="true" />
        sebastian-jf
      </a>
    </li> */}
    <li class="hero__place" id="hero-place">
      {/* A toggletip: hover, focus or tap shows the current time in Barcelona. */}
      <button
        class="hero__location"
        id="hero-location"
        type="button"
        aria-describedby="hero-local-time"
        data-template={t("hero.localTime")}
      >
        <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path>
        </svg>
        {t("hero.location")}
      </button>
      <span class="hero__time" id="hero-local-time" role="tooltip"></span>
    </li>
  </ul>
  <a class="hero__status" href="#contact">
    <span class="hero__status-dot" aria-hidden="true"></span>
    {t("hero.availableForWork")}
  </a>
</header>

<script>
  const $place = document.getElementById("hero-place");
  const $location = document.getElementById("hero-location");
  const $time = document.getElementById("hero-local-time");

  // Always Madrid time, in the clock style of the page language (2:32 PM / 14:32).
  const clock = new Intl.DateTimeFormat(document.documentElement.lang, {
    hour: "numeric",
    minute: "2-digit",
    timeZone: "Europe/Madrid",
  });
  const update = () => {
    $time.textContent = $location.dataset.template.replace("{time}", clock.format(new Date()));
  };

  update();
  setInterval(update, 20_000);

  // Hover and keyboard focus are handled in CSS; a tap (or click) toggles it, for touch screens.
  const setOpen = (open: boolean) => $place.classList.toggle("hero__place--open", open);

  $location.addEventListener("click", (event) => {
    event.stopPropagation();
    update();
    setOpen(!$place.classList.contains("hero__place--open"));
  });
  $location.addEventListener("pointerenter", update);
  $location.addEventListener("focus", update);

  document.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
</script>

<section>
  <div class="profile">
    <p>
      <Trans i18nKey="hero.aboutme2">
        I build <span class="highlight">web experiences</span> focused on clarity, performance,
        and precision.
      </Trans>
    </p>
    <p>
      {t("hero.projectsText")} <a class="profile__link" href="#projects">{t("hero.projectsButton")}</a>.
      {t("hero.contactText")} <a class="profile__link" href="#contact">{t("hero.contactButton")}</a>.
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 56px 0 8px;
    text-align: center;
  }

  .hero__name {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hero__role {
    margin: 6px 0 0;
    font-size: 1.35rem;
    font-style: italic;
    color: var(--text);
  }

  .hero__contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    margin: 18px 0 0;

    & > li,
    & a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--text);
    }

    & a {
      text-decoration: underline;
      text-decoration-color: var(--border-strong);
      text-underline-offset: 3px;
      transition: text-decoration-color 0.2s var(--ease-out);

      &:hover {
        text-decoration-color: currentColor;
      }

      &:active {
        color: var(--text-muted);
      }
    }
  }

  /* The location is not a link: a dotted underline says "there's more here" instead. */
  .hero__place {
    position: relative;
  }

  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
    text-decoration: underline dotted;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    border-radius: var(--radius-sm);
    transition: text-decoration-color 0.2s var(--ease-out);

    &:hover {
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text-muted);
    }
  }

  .hero__time {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: var(--z-dropdown);
    padding: 6px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    box-shadow: var(--shadow-float);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
    white-space: nowrap;
    pointer-events: none;

    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -4px);
    transition:
      opacity 120ms var(--ease-out),
      transform 120ms var(--ease-out),
      visibility 0s linear 120ms;
  }

  /* Without JavaScript there is no time to show. */
  .hero__time:empty {
    display: none;
  }

  .hero__place:hover .hero__time,
  .hero__location:focus-visible + .hero__time,
  .hero__place--open .hero__time {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out),
      visibility 0s;
  }

  .hero__icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 16px;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--text-muted);

    &:hover {
      color: var(--text-strong);
    }

    &:active {
      color: var(--text);
    }
  }

  .hero__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--status);
    animation: pulse 1800ms infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--status);
    }
    75% {
      box-shadow: 0 0 0 6px transparent;
    }
  }

  @media (pointer: coarse) {
    /* Rows of links stay visually tight, but each one is a full-height target. */
    .hero__contact {
      row-gap: 0;

      & a,
      & .hero__location {
        min-height: var(--tap);
      }
    }

    .hero__status {
      min-height: var(--tap);
      margin-top: 4px;
    }
  }

  .profile > p {
    margin: 0 0 0.7em;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .profile__link {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out);

    &:hover {
      text-decoration-color: currentColor;
    }
  }
</style>
