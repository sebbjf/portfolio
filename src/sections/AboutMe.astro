---
import { Image } from "astro:assets";
import { t } from "i18next";
import { Trans } from "astro-i18next/components";
import { localizePath } from "astro-i18next";
import LinkAnchor from "../components/LinkAnchor.astro";
import GithubIcon from "../icons/github.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import EmailIcon from "../icons/email.astro";
import ShortcutMenu from "../components/ShortcutMenu.astro";
---

<section style="margin-top: 0;">
  <div id="aboutme" class="hero__name-container">
    <Image
      class="hero__avatar"
      src="https://avatars.githubusercontent.com/u/108923627?v=4"
      alt="sebbjf"
      title="sebbjf's avatar"
      width="1200"
      height="1200"
      loading="eager"
    />
    <div>
      <h1 class="hero__name accent">seb</h1>
      <!-- <p class="hero__username">@sebbjf</p> -->
      <a class="hero__undername" href="#contact"
        ><span class="pulse_dot"></span> {t("hero.availableForWork")}</a
      >
    </div>
  </div>
  <h2 class="hero__hey accent">
    <span class="wave">👋</span> {t("hero.hey")}
  </h2>

  <p>
    {t("hero.aboutme1")}
    <br /><br />

    <Trans i18nKey="hero.aboutme2">
      I build <span class="highlight">web experiences</span> focused on clarity, performance,
      and precision.
    </Trans>
    <br /><br />

    {t("hero.aboutme3")}
    <br /><br />

    {t("hero.projectsText")}
    <LinkAnchor content={t("hero.projectsButton")} to="#projects" />.
    <br />

    {t("hero.contactText")}
    <LinkAnchor content={t("hero.contactButton")} to="#contact" />!
  </p>
  <div class="hero__links">
    <a
      class="hero__link"
      href="https://github.com/sebbjf/"
      title="seb's Github page"
      target="__blank"
    >
      <span class="hero__link_icon">
        <GithubIcon />
      </span>
      Github
    </a>
    <a
      class="hero__link"
      href="mailto:hi@sebastianjf.com"
      title="seb's email"
      target="__blank"
    >
      <span class="hero__link_icon mail">
        <EmailIcon />
      </span>
      hi@sebastianjf.com
    </a>
    <a
      class="hero__link"
      href="https://wwww.linkedin.com/in/sebastian-jf/"
      title="seb's Linkedin page"
      target="__blank"
    >
      <span class="hero__link_icon">
        <LinkedinIcon />
      </span>
      LinkedIn
    </a>
  </div>
  <!-- <ShortcutMenu /> -->
</section>

<style>
  .wave {
    animation-name: wave-animation;
    animation-duration: 2.5s;
    animation-iteration-count: 3;
    transform-origin: 70% 70%;
    display: inline-block;
  }

  .wave:hover {
    animation: none;
    animation: wave-animation 2.5s infinite;
  }

  @keyframes wave-animation {
    0% {
      transform: rotate(0deg);
    }
    10% {
      transform: rotate(14deg);
    }
    20% {
      transform: rotate(-8deg);
    }
    30% {
      transform: rotate(14deg);
    }
    40% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(10deg);
    }
    60% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  .hero__name-container {
    display: flex;
    height: 200px;
    align-items: center;
    gap: 35px;
    margin-bottom: -25px;
  }

  .hero__avatar {
    border-radius: 100%;
    height: 60%;
    width: auto;
  }

  .hero__name {
    margin-bottom: -3px;
  }

  .hero__username {
    display: flex;
    align-items: center;
    justify-items: center;
    gap: 8px;
    margin-top: 3px;
    color: var(--gray);
  }

  .hero__link {
    display: flex;
    align-items: center;
    justify-items: center;
    gap: 8px;
    margin-top: 3px;
    color: #fff;

    &:hover {
      text-decoration: underline;
    }
  }

  .hero__link_icon {
    line-height: 1;
  }

  .hero__links {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 50px;
    flex-wrap: wrap;
  }

  .hero__hey {
    font-size: 28px;
    margin-bottom: -8px;
  }

  .hero__undername {
    display: flex;
    align-items: center;
    font-size: 14px;
    color: #c5e0ae;
    gap: 12px;
    text-wrap: nowrap;
  }

  .pulse_dot {
    height: 8px;
    width: 8px;
    display: block;
    border-radius: 50%;
    background-color: #62bd19;
    animation: pulse 1500ms infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: #62bd19 0 0 0 0;
    }
    75% {
      box-shadow: #ff69b400 0 0 0 6px;
    }
  }

  @media only screen and (max-width: 768px) {
    .hero__links {
      gap: 10px;
    }
  }
</style>
