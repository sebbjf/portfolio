---
import { useTranslations } from "../utils/i18n";
import education from "../consts/education.js";
import { formatPeriod } from "../utils/formatPeriod.js";
import "../styles/entries.css";

const t = useTranslations(Astro.currentLocale);

const currentLanguage = Astro.currentLocale;

const localize = (e, key) => e.translation?.[currentLanguage]?.[key] ?? e[key];
---

<section aria-labelledby="education">
  <h2 id="education">{t("education.title")}</h2>
  <ul class="entries">
    {
      education.map((e) => (
        <li class="entry">
          {/* Decorative: the institution's name is right next to it. */}
          <img class="entry__logo" src={e.logo} alt="" width="40" height="40" loading="lazy" decoding="async" />
          <div class="entry__body">
            <h3 class="entry__title">{localize(e, "title")}</h3>
            <p class="entry__org">{e.institution}</p>
            <p class="entry__date">
              {formatPeriod(e.startDate, e.endDate, currentLanguage, t("experience.currently"))}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* The logo sits in its own column, so the text keeps the résumé entry's alignment. */
  .entry {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
  }

  .entry__logo {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  /* Like the résumé: course and date on the first line, the institution in italics below it. */
  .entry__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "title date"
      "org   org";
    align-items: baseline;
    column-gap: 24px;
  }

  .entry__title {
    grid-area: title;
  }

  .entry__org {
    grid-area: org;
    margin: 0;
    font-style: italic;
  }

  .entry__date {
    grid-area: date;
  }

  /* Phones: one column, reading course, institution, then date. */
  @media only screen and (max-width: 600px) {
    .entry__body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "title"
        "org"
        "date";
    }
  }
</style>
