---
import { useTranslations } from "../utils/i18n";
import Project from "../components/Project.astro";
import projects from "../consts/projects";

const t = useTranslations(Astro.currentLocale);

const getProjectDescription = (project, language) => {
  return project.translation && project.translation[language] ? project.translation[language].description : project.description;
};

const currentLanguage = Astro.currentLocale;
---

<section aria-labelledby="projects">
  <h2 id="projects">{t("projects.title")}</h2>
  <ol class="projects__list">
    {
      projects.map((projectData) => (
        <Project projectData={{ ...projectData, description: getProjectDescription(projectData, currentLanguage) }} />
      ))
    }
  </ol>
</section>

<style>
  .projects__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
</style>
