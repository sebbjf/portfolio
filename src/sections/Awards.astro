---
import { useTranslations } from "../utils/i18n";
import awards from "../consts/awards.js";
import TrophyIcon from "../icons/trophy.astro";
import "../styles/entries.css";

const t = useTranslations(Astro.currentLocale);

const currentLanguage = Astro.currentLocale;

const localize = (a, key) => (a.translation && a.translation[currentLanguage]?.[key]) || a[key];
---

<section aria-labelledby="awards">
  <h2 id="awards" data-reveal>{t("awards.title")}</h2>
  <ul class="entries">
    {
      awards.map((a, i) => (
        <li class:list={["entry", { "entry--trophy": a.firstPlace }]} data-reveal style={`--i: ${i}`}>
          <div class="entry__head">
            <h3 class="entry__title">
              {a.firstPlace && <TrophyIcon class="trophy" aria-hidden="true" />}
              {localize(a, "title")}
            </h3>
            <p class="entry__date">{a.date}</p>
          </div>
          <p class="entry__org">
            {a.url ? (
              <a class="entry__link" href={a.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
                {a.event}
              </a>
            ) : (
              a.event
            )}
          </p>
          <p class="entry__description">{localize(a, "description")}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .entry__org {
    margin: 0;
  }

  /* The trophy shifts the title text right; indent the lines below by the same amount so they align with it. */
  .entry--trophy .entry__org,
  .entry--trophy .entry__description {
    padding-left: 1.12em;
  }

  /* Inline with the title; the title already says "First Place", so the icon is decorative. */
  .trophy {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 0.12em;
    vertical-align: -0.125em;
    color: var(--trophy);
  }
</style>
