---
import i18next, { t } from "i18next";
import awards from "../consts/awards.js";
import "../styles/entries.css";

const currentLanguage = i18next.language;

const localize = (a, key) => (a.translation && a.translation[currentLanguage]?.[key]) || a[key];
---

<section aria-labelledby="awards">
  <h2 id="awards">{t("awards.title")}</h2>
  <ul class="entries">
    {
      awards.map((a) => (
        <li class="entry">
          <div class="entry__head">
            <h3 class="entry__title">
              {localize(a, "title")},
              <em class="entry__org">
                {a.url ? (
                  <a class="entry__link" href={a.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
                    {a.event}
                  </a>
                ) : (
                  a.event
                )}
              </em>
            </h3>
            <p class="entry__date">{a.date}</p>
          </div>
          <p class="entry__description">{localize(a, "description")}</p>
        </li>
      ))
    }
  </ul>
</section>
