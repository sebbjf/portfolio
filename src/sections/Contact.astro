---
import { t } from "i18next";
import { Trans } from "astro-i18next/components";
import LinkAnchor from "../components/LinkAnchor.astro";
import Tooltip from "../components/Tooltip.astro";
import EmailIcon from "../icons/email.astro";
---

<section class="contact__container" aria-labelledby="contact">
  <p class="contact__badge">{t("contact.title")}</p>
  <h2 class="contact__title" id="contact">{t("contact.title2")}</h2>
  <div class="contact__main">
    <div class="contact__text-container">
      <p>{t("contact.text1")}</p>
      <p>
        {t("contact.text2")}
        <LinkAnchor to="mailto:hi@sebastianjf.com" content="email" />
        {t("contact.text3")}
        <LinkAnchor to="https://www.linkedin.com/in/sebastian-jf/" content="LinkedIn" target="_blank" rel="noopener noreferrer" />
        {t("contact.text4")}
      </p>
    </div>
    <div class="contact__links">
      <Tooltip content={t("contact.toCopy")} id="email-tooltip" role="status">
        <button
          class="contact__email"
          id="email-button"
          type="button"
          data-copy={t("contact.toCopy")}
          data-copied={t("contact.copied")}
          data-copy-error={t("contact.copyError")}
        >
          <EmailIcon class:list={"contact__email-icon"} aria-hidden="true" />
          hi@sebastianjf.com
        </button>
      </Tooltip>
      <LinkAnchor to="https://www.linkedin.com/in/sebastian-jf/" content="LinkedIn" target="_blank" rel="noopener noreferrer" />
    </div>
  </div>
</section>

<script>
  const emailButton = document.getElementById("email-button");
  const emailTooltip = document.getElementById("email-tooltip");
  const { copy, copied, copyError } = emailButton.dataset;
  let resetTimeout: ReturnType<typeof setTimeout>;

  const showMessage = (message: string) => {
    emailTooltip.textContent = message;
    emailTooltip.classList.add("tooltip__message--visible");
    clearTimeout(resetTimeout);
    resetTimeout = setTimeout(() => {
      emailTooltip.textContent = copy;
      emailTooltip.classList.remove("tooltip__message--visible");
    }, 3000);
  };

  emailButton.addEventListener("click", () => {
    navigator.clipboard
      .writeText("hi@sebastianjf.com")
      .then(() => showMessage(copied))
      .catch(() => showMessage(copyError));
  });
</script>

<style>
  .contact__container {
    margin: 115px 0;
  }

  .contact__badge {
    text-align: center;
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }

  .contact__title {
    text-align: center;
    margin: 0;
    margin-bottom: 40px;
    font-size: 3.125rem;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    position: relative;
    z-index: 1;
  }

  .contact__title::before {
    content: "";
    position: absolute;
    inset: -40px 10% -160px;
    background: radial-gradient(ellipse at center, var(--accent), transparent 70%);
    filter: blur(60px);
    opacity: 0.12;
    z-index: -5;
    pointer-events: none;
  }

  .contact__main {
    display: flex;
    flex-direction: column;
    padding: 0 50px;
    gap: 50px;
    position: relative;
    z-index: 1;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    gap: 5px;
    color: var(--text-strong);
    padding: 4px 10px;
    border-radius: var(--radius-md);
    transition: background-color 0.2s var(--ease-out);

    &:hover {
      background-color: var(--surface-hover);
    }

    &:active {
      transform: translateY(1px);
    }
  }

  .contact__text-container {
    & > p {
      margin: 0 0 1.2em;
    }

    & > p:last-child {
      margin-bottom: 0;
    }
  }

  .contact__links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 10px;
  }

  .contact__email-icon {
    width: 25px;
    height: auto;
  }

  @media only screen and (max-width: 768px) {
    .contact__main {
      padding: 0 18px;
    }

    .contact__title {
      font-size: 2.6rem;
    }
  }
</style>
