---
import { t } from "i18next";
import { localizePath } from "astro-i18next";

const email = "hi@sebastianjf.com";

const channels = [
  // { label: "LinkedIn", value: "in/sebastian-jf", href: "https://www.linkedin.com/in/sebastian-jf/", external: true },
  { label: "GitHub", value: "sebbjf", href: "https://github.com/sebbjf/", external: true },
  { label: t("contact.resume"), value: "PDF", href: localizePath("/resume"), external: true },
];
---

<section aria-labelledby="contact">
  <h2 id="contact">{t("contact.title")}</h2>
  <p class="contact__text">{t("contact.text")}</p>
  <dl class="contact__list">
    <div class="contact__row">
      <dt>{t("contact.email")}</dt>
      <dd>
        <a class="contact__link" href={`mailto:${email}`}>{email}</a>
        <button
          class="contact__copy"
          id="email-copy"
          type="button"
          aria-label={t("contact.copyLabel")}
          data-email={email}
          data-copy={t("contact.copy")}
          data-copied={t("contact.copied")}
          data-copy-error={t("contact.copyError")}
        >
          {t("contact.copy")}
        </button>
        <span class="contact__status" id="email-copy-status" role="status"></span>
      </dd>
    </div>
    {
      channels.map(({ label, value, href, external }) => (
        <div class="contact__row">
          <dt>{label}</dt>
          <dd>
            <a class="contact__link" href={href} {...(external && { target: "_blank", rel: "noopener noreferrer" })}>
              {value}
              <span class="contact__arrow" aria-hidden="true">↗</span>
            </a>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<script>
  const $copy = document.getElementById("email-copy");
  const $status = document.getElementById("email-copy-status");
  const { email, copy, copied, copyError } = $copy.dataset;
  let resetTimeout: ReturnType<typeof setTimeout>;

  const showResult = (message: string) => {
    $copy.textContent = message;
    $status.textContent = message;
    clearTimeout(resetTimeout);
    resetTimeout = setTimeout(() => {
      $copy.textContent = copy;
      $status.textContent = "";
    }, 2000);
  };

  $copy.addEventListener("click", () => {
    navigator.clipboard
      .writeText(email)
      .then(() => showResult(copied))
      .catch(() => showResult(copyError));
  });
</script>

<style>
  .contact__text {
    margin: 0 0 24px;
  }

  .contact__list {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: baseline;
    column-gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);

    & > dt {
      font-weight: 700;
      color: var(--text-strong);
    }

    & > dd {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 14px;
      margin: 0;
      min-width: 0;
    }
  }

  .contact__link {
    color: var(--text);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out), color 0.2s var(--ease-out);

    &:hover {
      color: var(--text-strong);
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text-muted);
    }
  }

  .contact__arrow {
    display: inline-block;
    margin-left: 2px;
    color: var(--text-subtle);
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .contact__link:hover .contact__arrow {
    color: currentColor;
    transform: translate(2px, -2px);
  }

  .contact__copy {
    padding: 1px 8px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out);

    &:hover {
      background-color: var(--surface-hover);
      color: var(--text-strong);
    }

    &:active {
      transform: translateY(1px);
    }
  }

  /* The button text already changes visibly; this region only announces it to screen readers. */
  .contact__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Touch: the row keeps its height, but the link and the copy button fill it. */
  @media (pointer: coarse) {
    .contact__row {
      padding: 0;
      min-height: calc(var(--tap) + 8px);
      align-items: center;
    }

    .contact__row > dd {
      align-items: center;
      column-gap: 8px;
    }

    .contact__link {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }

    .contact__copy {
      position: relative;
      min-height: 36px;
      min-width: var(--tap);
      padding-inline: 12px;

      /* Grow the hit area to the full tap size without making the button look heavier. */
      &::after {
        content: "";
        position: absolute;
        inset: calc((var(--tap) - 36px) / -2) 0;
      }
    }
  }

  @media only screen and (max-width: 768px) {
    .contact__row {
      grid-template-columns: 6.5rem 1fr;
    }
  }

  /* Narrow phones: the label sits above its value so the email address never wraps mid-word. */
  @media only screen and (max-width: 420px) {
    .contact__row {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 10px;

      & > dt {
        font-size: 0.85rem;
        font-weight: 400;
        font-style: italic;
        color: var(--text-muted);
      }
    }
  }
</style>
