---
import { useTranslations, localizePath } from "../utils/i18n";

const t = useTranslations(Astro.currentLocale);

const email = "hi@sebastianjf.com";

const channels = [
  // { label: "LinkedIn", href: "https://www.linkedin.com/in/sebastian-jf/" },
  { label: "GitHub", href: "https://github.com/sebbjf/" },
  { label: t("contact.resume"), href: localizePath("/resume", Astro.currentLocale) },
];
---

<section class="contact" aria-labelledby="contact" data-reveal>
  <h2 id="contact" class="contact__title">{t("contact.title")}</h2>  <p class="contact__text">{t("contact.text")}</p>
  <div class="contact__email" id="contact-email">
    <a class="contact__mail" href={`mailto:${email}`}>{email}</a>
    <button
      class="contact__copy"
      id="email-copy"
      type="button"
      aria-label={t("contact.copyLabel")}
      data-email={email}
      data-copy={t("contact.copy")}
      data-copied={t("contact.copied")}
      data-copy-error={t("contact.copyError")}
    >
      {t("contact.copy")}
    </button>
    <span class="visually-hidden" id="email-copy-status" role="status"></span>
  </div>
  <ul class="contact__links">
    {
      channels.map(({ label, href }) => (
        <li>
          <a class="contact__link" href={href} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
            {label}
            <span class="contact__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const $copy = document.getElementById("email-copy");
  const $status = document.getElementById("email-copy-status");
  const { email, copy, copied, copyError } = $copy.dataset;
  let resetTimeout: ReturnType<typeof setTimeout>;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const spring = getComputedStyle(document.documentElement).getPropertyValue("--ease-spring");

  // The button morphs to the width of its new label instead of jumping.
  const setLabel = (label: string) => {
    const from = $copy.offsetWidth;
    $copy.textContent = label;
    const to = $copy.offsetWidth;
    if (reduceMotion.matches || from === to) return;
    // Clipped only while it moves: the touch hit area (::after) reaches outside the button.
    $copy.style.overflow = "hidden";
    $copy.animate([{ width: `${from}px` }, { width: `${to}px` }], { duration: 450, easing: spring }).onfinish = () =>
      $copy.style.removeProperty("overflow");
  };

  const showResult = (message: string) => {
    setLabel(message);
    $status.textContent = message;
    clearTimeout(resetTimeout);
    resetTimeout = setTimeout(() => {
      setLabel(copy);
      $status.textContent = "";
    }, 2000);
  };

  // Arriving from "get in touch" or "available for work": once the scroll settles, the email
  // glows once so the eye lands on how to reach me. Skipped with reduced motion.
  const $email = document.getElementById("contact-email");

  const flashEmail = () => {
    if (reduceMotion.matches) return;
    $email.classList.remove("contact__email--flash");
    void $email.offsetWidth; // restart the animation if it is already running
    $email.classList.add("contact__email--flash");
  };

  document.querySelectorAll("a[data-flash-contact]").forEach((link) => {
    link.addEventListener("click", () => {
      let done = false;
      const run = () => {
        if (done) return;
        done = true;
        flashEmail();
      };
      window.addEventListener("scrollend", run, { once: true });
      setTimeout(run, 1000); // no scrollend support, or already at Contact
    });
  });

  $copy.addEventListener("click", () => {
    navigator.clipboard
      .writeText(email)
      .then(() => showResult(copied))
      .catch(() => showResult(copyError));
  });
</script>

<style>
  /* Extra air above sets the closing call to action apart without a frame. */
  .contact {
    margin-top: 112px;
  }

  .contact__title {
    margin: 0 0 12px;
  }

  .contact__text {
    max-width: 34rem;
    margin: 0 0 24px;
    color: var(--text-muted);
  }

  .contact__email {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .contact__mail {
    font-weight: 700;
    color: var(--text-strong);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out), color 0.2s var(--ease-out);

    &:hover {
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text-muted);
    }
  }

  .contact__copy {
    white-space: nowrap;
    padding: 2px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      scale 0.14s var(--ease-out);

    &:hover {
      background-color: var(--surface-hover);
      color: var(--text-strong);
    }

    &:active {
      scale: 0.97;
    }
  }

  /* Arriving from "get in touch": a soft band appears behind the address, holds, and fades, while
     the underline brightens. Only opacity and color change; layout stays put. */
  .contact__email--flash {
    &::before {
      content: "";
      position: absolute;
      inset: -6px -12px;
      z-index: -1;
      border-radius: var(--radius-md);
      background-color: var(--tint-active);
      animation: contact-glow 1.6s both;
    }

    & .contact__mail {
      animation: contact-ink 1.6s var(--ease-out);
    }
  }

  @keyframes contact-glow {
    0% {
      opacity: 0;
      animation-timing-function: var(--ease-out);
    }
    15%,
    65% {
      opacity: 1;
      animation-timing-function: ease-in-out;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes contact-ink {
    20%,
    65% {
      text-decoration-color: currentColor;
    }
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 12px 0 0;
  }

  /* Muted until hovered, like the links in the header. */
  .contact__link {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s var(--ease-out), color 0.2s var(--ease-out);

    &:hover {
      color: var(--text-strong);
      text-decoration-color: currentColor;
    }

    &:active {
      color: var(--text);
    }
  }

  .contact__arrow {
    display: inline-block;
    margin-left: 2px;
    color: var(--text-subtle);
    transition: transform 0.45s var(--ease-spring), color 0.2s var(--ease-out);
  }

  .contact__link:hover .contact__arrow {
    color: currentColor;
    transform: translate(2px, -2px);
  }

  @media only screen and (max-width: 768px) {
    .contact {
      margin-top: 80px;
    }
  }

  /* Touch: links and the copy button reach the minimum tap size. */
  @media (pointer: coarse) {
    .contact__link {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }

    .contact__copy {
      position: relative;
      min-height: 36px;
      min-width: var(--tap);
      padding-inline: 12px;

      /* Grow the hit area to the full tap size without making the button look heavier. */
      &::after {
        content: "";
        position: absolute;
        inset: calc((var(--tap) - 36px) / -2) 0;
      }
    }
  }
</style>
