---
import { useTranslations, localizePath } from "../utils/i18n";

const t = useTranslations(Astro.currentLocale);

const email = "hi@sebastianjf.com";

const channels = [
  // { label: "LinkedIn", href: "https://www.linkedin.com/in/sebastian-jf/" },
  { label: "GitHub", href: "https://github.com/sebbjf/" },
  { label: t("contact.resume"), href: localizePath("/resume", Astro.currentLocale) },
];
---

<section class="contact" aria-labelledby="contact">
  <h2 id="contact" class="contact__title" data-reveal>{t("contact.title")}</h2>
  <p class="contact__text" data-reveal style="--i: 1">{t("contact.text")}</p>
  <div class="contact__email" id="contact-email" data-reveal style="--i: 2">
    <a class="contact__mail" href={`mailto:${email}`} aria-label={email}>
      {[...email].map((char, n) => <span class="contact__char" style={`--n: ${n}`} aria-hidden="true">{char}</span>)}
    </a>
    <button
      class="contact__copy"
      id="email-copy"
      type="button"
      aria-label={t("contact.copyLabel")}
      data-email={email}
      data-copy={t("contact.copy")}
      data-copied={t("contact.copied")}
      data-copy-error={t("contact.copyError")}
    >
      {t("contact.copy")}
    </button>
    <span class="visually-hidden" id="email-copy-status" role="status"></span>
  </div>
  <ul class="contact__links" data-reveal style="--i: 3">
    {
      channels.map(({ label, href }) => (
        <li>
          <a class="contact__link" href={href} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
            {label}
            <span class="contact__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const $copy = document.getElementById("email-copy");
  const $status = document.getElementById("email-copy-status");
  const { email, copy, copied, copyError } = $copy.dataset;
  let resetTimeout: ReturnType<typeof setTimeout>;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const spring = getComputedStyle(document.documentElement).getPropertyValue("--ease-spring");

  // The button morphs to the width of its new label instead of jumping.
  const setLabel = (label: string) => {
    const from = $copy.offsetWidth;
    $copy.textContent = label;
    const to = $copy.offsetWidth;
    if (reduceMotion.matches || from === to) return;
    // Clipped only while it moves: the touch hit area (::after) reaches outside the button.
    $copy.style.overflow = "hidden";
    $copy.animate([{ width: `${from}px` }, { width: `${to}px` }], { duration: 450, easing: spring }).onfinish = () =>
      $copy.style.removeProperty("overflow");
  };

  const showResult = (message: string) => {
    setLabel(message);
    $status.textContent = message;
    clearTimeout(resetTimeout);
    resetTimeout = setTimeout(() => {
      setLabel(copy);
      $status.textContent = "";
    }, 2000);
  };

  // The page's signature: the letters of the address hop in a wave. It plays on hover (CSS), when a
  // copy succeeds, and on arriving from "get in touch" or "available for work" once the scroll
  // settles, so the eye lands on how to reach me. Skipped with reduced motion.
  const $mail = document.querySelector(".contact__mail");
  let waveTimeout: ReturnType<typeof setTimeout>;

  const waveEmail = () => {
    if (reduceMotion.matches) return;
    $mail.classList.remove("contact__mail--wave");
    void ($mail as HTMLElement).offsetWidth; // restart the animation if it is already running
    $mail.classList.add("contact__mail--wave");
    clearTimeout(waveTimeout);
    waveTimeout = setTimeout(() => $mail.classList.remove("contact__mail--wave"), 1600);
  };

  document.querySelectorAll("a[data-flash-contact]").forEach((link) => {
    link.addEventListener("click", () => {
      let done = false;
      const run = () => {
        if (done) return;
        done = true;
        waveEmail();
      };
      window.addEventListener("scrollend", run, { once: true });
      setTimeout(run, 1000); // no scrollend support, or already at Contact
    });
  });

  $copy.addEventListener("click", () => {
    navigator.clipboard
      .writeText(email)
      .then(() => {
        showResult(copied);
        waveEmail();
      })
      .catch(() => showResult(copyError));
  });
</script>

<style>
  /* Extra air above sets the closing call to action apart without a frame, and it is centered like
     the top of the page. The pieces arrive one after another as the section scrolls in. */
  .contact {
    margin-top: 88px;
    margin-bottom: 96px;
    text-align: center;
  }

  .contact__title {
    margin: 0 0 12px;
  }

  /* A step up in size and brightness: this is the sentence the section is for. */
  .contact__text {
    max-width: 32rem;
    margin: 0 auto 32px;
    font-size: 1.15rem;
    color: var(--text);
  }

  .contact__email {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
  }

  /* A faint underline at rest that brightens on hover, like the other links on the page. */
  .contact__mail,
  .contact__link {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--border-strong);
    transition:
      border-color 0.25s var(--ease-out),
      color 0.2s var(--ease-out);

    &:hover {
      border-color: currentColor;
    }

    &:active {
      color: var(--text);
    }
  }

  .contact__mail {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-strong);
    overflow-wrap: anywhere;

    &:active {
      color: var(--text-muted);
    }
  }

  /* On hover the letters hop up in a quick wave, left to right, each on the page's spring, and
     settle back when the cursor leaves. */
  .contact__char {
    display: inline-block;
    white-space: pre;
    transition: translate 0.5s var(--ease-spring);
    transition-delay: calc(var(--n) * 18ms);
  }

  .contact__mail:hover .contact__char {
    translate: 0 -3px;
  }

  /* Borderless: muted text that wakes up on a soft wash, like the links in the header. */
  .contact__copy {
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      scale 0.14s var(--ease-out);

    &:hover {
      background-color: var(--tint-hover);
      color: var(--text-strong);
    }

    &:active {
      background-color: var(--tint-active);
      scale: 0.97;
    }
  }

  @keyframes contact-hop {
    0% {
      translate: 0 0;
    }
    30% {
      translate: 0 -6px;
    }
    55% {
      translate: 0 1.5px;
    }
    78% {
      translate: 0 -1px;
    }
    100% {
      translate: 0 0;
    }
  }

  /* The wave, triggered from the script: each letter hops a beat after the one before it. */
  .contact__mail--wave .contact__char {
    animation: contact-hop 0.8s ease-out;
    animation-delay: calc(var(--n) * 30ms);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 24px;
    margin: 18px 0 0;
  }

  .contact__link {
    color: var(--text-muted);

    &:hover {
      color: var(--text-strong);
    }
  }

  .contact__arrow {
    display: inline-block;
    margin-left: 2px;
    color: var(--text-subtle);
    transition: transform 0.45s var(--ease-spring), color 0.2s var(--ease-out);
  }

  .contact__link:hover .contact__arrow {
    color: currentColor;
    transform: translate(2px, -2px);
  }

  @media only screen and (max-width: 768px) {
    .contact {
      margin-top: 72px;
      margin-bottom: 72px;
    }
  }

  /* Touch: links and the copy button reach the minimum tap size. */
  @media (pointer: coarse) {
    /* The row is tall, not the link, so the underline stays under the text. */
    .contact__links li {
      display: flex;
      align-items: center;
      min-height: var(--tap);
    }

    .contact__copy {
      position: relative;
      min-height: 36px;
      min-width: var(--tap);
      padding-inline: 12px;

      /* Grow the hit area to the full tap size without making the button look heavier. */
      &::after {
        content: "";
        position: absolute;
        inset: calc((var(--tap) - 36px) / -2) 0;
      }
    }
  }
</style>
