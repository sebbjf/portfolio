---
import { useTranslations } from "../utils/i18n";
import skills from "../consts/skills.js";
import Skill from "../components/Skill.astro";

const t = useTranslations(Astro.currentLocale);
---

<section aria-labelledby="skills" data-reveal>
  <h2 id="skills">{t("skills.title")}</h2>
  <ul class="skills__list" id="skills-list">
    {
      skills.map((s) => (
        <li>
          <Skill name={s.name} icon={s.icon} color={s.color} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Dock magnification: icons swell by their distance to the cursor, the nearest the most.
  const $list = document.getElementById("skills-list");
  const items = [...$list.children] as HTMLElement[];
  const dock = window.matchMedia("(hover: hover) and (min-width: 769px)");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const MAX_GROWTH = 0.5; // the icon under the cursor is 1.5× its size
  const RANGE = 170; // px from the cursor at which an icon stops growing

  let frame = 0;
  $list.addEventListener("pointermove", (event) => {
    if (!dock.matches || reduceMotion.matches) return;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      $list.classList.add("skills__list--active");
      for (const item of items) {
        const { left, width } = item.getBoundingClientRect();
        const distance = Math.abs(event.clientX - (left + width / 2));
        // A cosine bell: smooth at the peak and at the edge of the range.
        const growth = distance < RANGE ? (MAX_GROWTH * (1 + Math.cos((Math.PI * distance) / RANGE))) / 2 : 0;
        item.style.setProperty("--s", (1 + growth).toFixed(3));
      }
    });
  });

  $list.addEventListener("pointerleave", () => {
    cancelAnimationFrame(frame);
    $list.classList.remove("skills__list--active");
    for (const item of items) item.style.removeProperty("--s");
  });
</script>

<style>
  /* Touch and narrow screens: every skill visible at once in an aligned grid, each a small icon
     beside its name. No scrolling, nothing hidden. */
  .skills__list {
    --tile: 24px;

    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 16px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Dock: one row spanning the content width, edges aligned with the text. Icons grow upwards into the heading's
     margin, so at rest they sit at the usual distance and nothing below moves. While the cursor
     moves the size follows it closely; once it leaves, the icons spring back. */
  @media (hover: hover) and (min-width: 769px) {
    .skills__list {
      --tile: 48px;
      --dock-t: 0.5s var(--ease-spring);

      display: flex;
      flex-wrap: nowrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 8px;
      /* the largest icon */
      height: calc(var(--tile) * 1.5);
      margin-top: calc(var(--tile) * -0.5);
    }

    .skills__list--active {
      --dock-t: 0.14s var(--ease-out);
    }
  }
</style>
