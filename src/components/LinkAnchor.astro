---
import OpenLink from "../icons/open-link.astro";
const { content, to, ...props } = Astro.props;
---

<a class:list={"link"} href={to as string} {...props}>
  <OpenLink class:list={"link__icon"} aria-hidden="true" />
  {content}
</a>

<style>
  .link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    gap: 5px;
    color: var(--text-strong);
    padding: 2px 8px;
    border-radius: var(--radius-md);
    transition: background-color 0.2s var(--ease-out);
    margin-top: -10px;

    &:hover {
      background-color: var(--surface-hover);
    }
  }

  .link__icon {
    width: 15px;
    height: auto;
  }
</style>
