---
import Svg from "./Svg.astro";

interface Props {
  name: string;
  icon: string;
  color: string;
}

const { name, icon, color } = Astro.props;
---

<div class="skill" style={{ "--brand": color }}>
  <span class="skill__logo" aria-hidden="true">
    <Svg src={icon} class="skill__icon skill__icon--ink" />
    <Svg src={icon} class="skill__icon skill__icon--brand" />
  </span>
  <span class="skill__name">{name}</span>
</div>

<style>
  .skill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;

    /* Exit: slower than the entrance, so sweeping across the row leaves a soft trail. */
    --fade: 320ms;
  }

  /* Phones and touch: a bare icon beside its name, nothing else. --tile is the icon's size and, in
     the dock (below), --s magnifies it; its height follows the width. */
  .skill__logo {
    display: grid;
    place-items: center;
    width: calc(var(--tile, 36px) * var(--s, 1));
    aspect-ratio: 1;
    transition: width var(--dock-t, 0.5s var(--ease-spring));
  }

  /* Two copies of the logo share one cell: plain ink on top, brand color underneath.
     Crossfading their opacity avoids the muddy gray an animated filter passes through. */
  .skill__icon {
    grid-area: 1 / 1;
    width: var(--icon, 100%);
    height: var(--icon, 100%);
    transition: opacity var(--fade) var(--ease-out);
  }

  /* Every logo at rest is the same bright ink, whatever colors its source file uses. */
  .skill__icon--ink {
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .skill__icon--brand {
    color: var(--brand);
    opacity: 0;
  }

  .skill__name {
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color var(--fade) var(--ease-out);
  }

  /* Dock (mouse, wide screens): each icon sits in an outlined tile, flat like the rest of the
     page: a hairline and nothing else. Hover reveals the brand color on the outline and the icon.
     The hover is mouse only, so it never sticks after a tap. Entrance is quick: 180ms. */
  @media (hover: hover) and (min-width: 769px) {
    .skill {
      --icon: 50%;
      flex-direction: column;
      gap: 6px;
      text-align: center;
    }

    /* The tiles carry the icon alone; the name shows under a tile on hover. It stays in the DOM for
       screen readers, and phones keep every name visible. */
    .skill__name {
      position: absolute;
      top: 100%;
      margin-top: 8px;
      font-size: 0.75rem;
      opacity: 0;
      transform: translateY(-3px);
      transition:
        opacity var(--fade) var(--ease-out),
        transform var(--fade) var(--ease-out),
        color var(--fade) var(--ease-out);
    }

    .skill__logo {
      border-radius: 22%;
      background-color: var(--surface);
      box-shadow:
        inset 0 0 0 1px var(--border-strong),
        inset 0 1px 0 rgb(255 255 255 / 0.06);
      transition:
        width var(--dock-t, 0.5s var(--ease-spring)),
        box-shadow var(--fade) var(--ease-out),
        scale 0.14s var(--ease-out);
    }

    .skill:active .skill__logo {
      scale: 0.95;
    }

    .skill:hover {
      --fade: 180ms;

      .skill__logo {
        box-shadow:
          inset 0 0 0 1px var(--brand),
          inset 0 1px 0 rgb(255 255 255 / 0.06);
      }

      .skill__icon--ink {
        opacity: 0;
      }

      .skill__icon--brand {
        opacity: 1;
      }

      .skill__name {
        opacity: 1;
        transform: none;
        color: var(--text-strong);
      }
    }
  }
</style>
