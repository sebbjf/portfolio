---
import Svg from "./Svg.astro";

interface Props {
  name: string;
  icon: string;
  color: string;
}

const { name, icon, color } = Astro.props;
---

<div class="skill" style={{ "--brand": color }}>
  <span class="skill__logo" aria-hidden="true">
    <Svg src={icon} class="skill__icon skill__icon--ink" />
    <Svg src={icon} class="skill__icon skill__icon--brand" />
  </span>
  <span class="skill__name">{name}</span>
</div>

<style>
  .skill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;

    /* Exit: slower than the entrance, so sweeping across the row leaves a soft trail. */
    --fade: 320ms;
  }

  /* Phones and touch: a bare icon beside its name, nothing else. --tile is the icon's size and, in
     the dock (below), --s magnifies it; its height follows the width. */
  .skill__logo {
    display: grid;
    place-items: center;
    width: calc(var(--tile, 36px) * var(--s, 1));
    aspect-ratio: 1;
    transition: width var(--dock-t, 0.5s var(--ease-spring));
  }

  /* Two copies of the logo share one cell: plain ink on top, brand color underneath.
     Crossfading their opacity avoids the muddy gray an animated filter passes through. */
  .skill__icon {
    grid-area: 1 / 1;
    width: var(--icon, 100%);
    height: var(--icon, 100%);
    transition: opacity var(--fade) var(--ease-out);
  }

  /* Every logo at rest is the same bright ink, whatever colors its source file uses. */
  .skill__icon--ink {
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .skill__icon--brand {
    color: var(--brand);
    opacity: 0;
  }

  .skill__name {
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color var(--fade) var(--ease-out);
  }

  /* Dock (mouse, wide screens): each icon sits on an app-icon tile, a soft top-lit gradient with a
     hairline and a faint shadow, so it reads as a small object rather than a flat box. Hover
     reveals the brand color, with a faint wash of it underneath. The hover is mouse only, so it
     never sticks after a tap. Entrance is quick: 180ms. */
  @media (hover: hover) and (min-width: 769px) {
    .skill {
      --icon: 50%;
      flex-direction: column;
      gap: 6px;
      text-align: center;
    }

    /* Quiet labels under the tiles: smaller and dimmer, so they read as captions, not a second row. */
    .skill__name {
      font-size: 0.75rem;
      color: var(--text-subtle);
    }

    .skill__logo {
      border-radius: 28%;
      background: linear-gradient(180deg, var(--surface-hover), var(--surface));
      box-shadow:
        inset 0 0 0 1px var(--chrome-border),
        inset 0 1px 0 rgb(255 255 255 / 0.06),
        0 6px 12px -6px rgb(0 0 0 / 0.6);
      transition:
        width var(--dock-t, 0.5s var(--ease-spring)),
        box-shadow 0.4s var(--ease-out),
        scale 0.14s var(--ease-out);
    }

    .skill:active .skill__logo {
      scale: 0.95;
    }

    .skill:hover {
      --fade: 180ms;

      .skill__logo {
        box-shadow:
          inset 0 0 0 1px var(--chrome-border),
          inset 0 1px 0 rgb(255 255 255 / 0.06),
          0 10px 22px -8px color-mix(in srgb, var(--brand) 40%, transparent);
      }

      .skill__icon--ink {
        opacity: 0;
      }

      .skill__icon--brand {
        opacity: 1;
      }

      .skill__name {
        color: var(--text-strong);
      }
    }
  }
</style>
