---
import Svg from "./Svg.astro";

interface Props {
  name: string;
  icon: string;
  color: string;
}

const { name, icon, color } = Astro.props;
---

<div class="skill__container">
  <Svg src={icon} class="skill__image" style={{ color: color }} aria-hidden="true" />
  <span class="skill__name">{name}</span>
</div>

<style>
  .skill__container {
    display: flex;
    flex-direction: column;
    text-align: center;
    align-items: center;
    gap: 8px;
    color: var(--text-strong);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 4px;
    transition:
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .skill__image {
    filter: brightness(0) invert(1);
    width: 25px;
    height: 25px;
    transition:
      transform 0.3s var(--ease-out),
      filter 0.3s var(--ease-out);
  }

  .skill__container:hover {
    background-color: var(--surface-hover);
    border-color: var(--border-strong);
  }

  .skill__container:hover .skill__image {
    transform: translateY(-3px);
    filter: brightness(1) invert(0);
  }

  .skill__name {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
</style>
