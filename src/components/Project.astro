---
import { Image } from "astro:assets";

interface Project {
  name: string;
  description: string;
  built_with: string[];
  url: string;
  image: string;
}

interface Props {
  projectData: Project;
}

const { projectData } = Astro.props;

// Screenshots live in src/assets so Astro can resize them and convert them to WebP at build time.
const screenshots = import.meta.glob<{ default: ImageMetadata }>("../assets/projects/*", { eager: true });
const screenshot = screenshots[`../assets/projects/${projectData.image}`]?.default;
if (!screenshot) throw new Error(`Project image "${projectData.image}" not found in src/assets/projects/`);

// The 16:10 frame crops a wider screenshot (object-fit: cover), so the image is drawn wider than
// its frame: frame width × 0.625 × the image's aspect ratio. Telling the browser the real drawn
// width (280px frame on desktop, full content width on phones) keeps it from picking a file
// that is too small on scaled displays.
const overflow = Math.max(1, 0.625 * (screenshot.width / screenshot.height));
const sizes = `(max-width: 768px) calc((100vw - 48px) * ${overflow.toFixed(3)}), ${Math.ceil(280 * overflow)}px`;

// Never upscale: smaller originals ship at their own width.
const widths = [...new Set([400, 600, 800, 1000, 1400].filter((w) => w < screenshot.width).concat(screenshot.width))];
---

<li class="project">
  <a class="project__link" href={projectData.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
    <span class="project__media">
      <Image
        class="project__thumb"
        src={screenshot}
        alt=""
        widths={widths}
        sizes={sizes}
        format="webp"
        quality={85}
        loading="lazy"
        decoding="async"
      />
    </span>
    <div class="project__body">
      <div class="project__head">
        <h3 class="project__title">{projectData.name}</h3>
        <svg class="project__arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <p class="project__stack">{projectData.built_with.join(", ")}</p>
      <p class="project__description">{projectData.description}</p>
    </div>
  </a>
</li>

<style>
  .project__link {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 26px;
    align-items: start;
    color: inherit;
    border-radius: var(--radius-sm);
  }

  .project__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    transition: border-color 0.3s var(--ease-out);
  }

  .project__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: grayscale(0.35);
    transition:
      transform 0.6s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .project__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .project__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.25s var(--ease-out);
  }

  .project__stack {
    margin: 0;
    font-style: italic;
    color: var(--text);
  }

  .project__description {
    margin: 4px 0 0;
    color: var(--text-muted);
  }

  .project__arrow {
    flex-shrink: 0;
    align-self: center;
    color: var(--text-subtle);
    transition:
      color 0.25s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .project__link:focus-visible {
    .project__title {
      text-decoration-color: currentColor;
    }

    .project__arrow {
      color: var(--text-strong);
      transform: translate(2px, -2px);
    }

    .project__media {
      border-color: var(--border-strong);
    }

    .project__thumb {
      filter: none;
    }
  }

  .project__link:active .project__thumb {
    filter: none;
    transform: scale(1.02);
  }

  /* Only devices that can hover get the hover reveal; on touch it would stick after a tap. */
  @media (hover: hover) {
    .project__link:hover {
      .project__title {
        text-decoration-color: currentColor;
      }

      .project__arrow {
        color: var(--text-strong);
        transform: translate(2px, -2px);
      }

      .project__media {
        border-color: var(--border-strong);
      }

      .project__thumb {
        filter: none;
        transform: scale(1.04);
      }
    }
  }

  /* Touch screens never trigger the hover reveal, so show the screenshots in full color. */
  @media (hover: none) {
    .project__thumb {
      filter: none;
    }
  }

  @media only screen and (max-width: 768px) {
    /* Full-width screenshot above the text on small screens. */
    .project__link {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
  }
</style>
