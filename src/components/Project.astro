---
import { Image } from "astro:assets";

interface Project {
  name: string;
  description: string;
  built_with: string[];
  url: string;
  image: string;
}

interface Props {
  projectData: Project;
  index: number;
}

const { projectData, index } = Astro.props;

// Screenshots live in src/assets so Astro can resize them and convert them to WebP at build time.
const screenshots = import.meta.glob<{ default: ImageMetadata }>("../assets/projects/*", { eager: true });
const screenshot = screenshots[`../assets/projects/${projectData.image}`]?.default;
if (!screenshot) throw new Error(`Project image "${projectData.image}" not found in src/assets/projects/`);

// The 16:10 frame crops a wider screenshot (object-fit: cover), so the image is drawn wider than
// its frame: frame width × 0.625 × the image's aspect ratio. Telling the browser the real drawn
// width (one gallery column: 354px on desktop, half the content width on tablets, all of it on
// phones) keeps it from picking a file that is too small on scaled displays.
const overflow = Math.max(1, 0.625 * (screenshot.width / screenshot.height)).toFixed(3);
const sizes = [
  `(max-width: 560px) calc((100vw - 48px) * ${overflow})`,
  `(max-width: 768px) calc((100vw - 76px) / 2 * ${overflow})`,
  `${Math.ceil(354 * overflow)}px`,
].join(", ");

// Never upscale: smaller originals ship at their own width.
const widths = [...new Set([400, 600, 800, 1000, 1400].filter((w) => w < screenshot.width).concat(screenshot.width))];
---

<li class="project" data-reveal style={`--i: ${index}`}>
  <a class="project__link" href={projectData.url} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint">
    <span class="project__media">
      <Image
        class="project__thumb"
        src={screenshot}
        alt=""
        widths={widths}
        sizes={sizes}
        format="webp"
        quality={85}
        loading="lazy"
        decoding="async"
      />
    </span>
    <div class="project__body">
      <div class="project__head">
        <h3 class="project__title">{projectData.name}</h3>
        <svg class="project__arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <p class="project__description">{projectData.description}</p>
    </div>
  </a>
</li>

<style>
  /* The cards come in faster than the rest of the page's scroll reveal. */
  :global(.js) .project[data-reveal] {
    transition:
      opacity 0.35s var(--ease-out),
      filter 0.35s var(--ease-out),
      translate 0.5s var(--ease-spring);
    transition-delay: calc(min(var(--i, 0), 6) * 25ms);
  }

  .project__link {
    display: block;
    color: inherit;
    border-radius: var(--radius-sm);
  }

  /* A soft, borderless frame in full color: the screenshot is the hero of the card. The frame stays
     put, like every other surface on the page. Hover does what it does everywhere else: whatever is
     muted wakes up (here the screenshot brightens) and the one thing that moves springs (the image
     eases in a little closer, the arrow nudges). */
  .project__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 14px;
    background-color: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--chrome-border),
      0 8px 20px -10px rgb(0 0 0 / 0.55);
    transition: transform 0.45s var(--ease-spring);
  }

  .project__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: brightness(0.85);
    transition:
      transform 0.7s var(--ease-spring),
      filter 0.3s var(--ease-out);
  }

  /* The title and the arrow share one line; the arrow sits at the end. */
  .project__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 16px;
  }

  .project__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.25s var(--ease-out);
  }

  .project__description {
    margin: 6px 0 0;
    color: var(--text-muted);
    transition: color 0.25s var(--ease-out);
  }

  .project__arrow {
    flex-shrink: 0;
    align-self: center;
    color: var(--text-subtle);
    transition:
      color 0.25s var(--ease-out),
      transform 0.45s var(--ease-spring);
  }

  .project__link:focus-visible {
    .project__title {
      text-decoration-color: currentColor;
    }

    .project__arrow {
      color: var(--text-strong);
      transform: translate(2px, -2px);
    }

    .project__description {
      color: var(--text);
    }

    .project__thumb {
      filter: none;
    }
  }

  .project__link:active .project__media {
    transform: scale(0.985);
  }

  /* Touch screens never trigger the hover reveal, so show the screenshots at full brightness. */
  @media (hover: none) {
    .project__thumb {
      filter: none;
    }
  }

  /* Only devices that can hover get the hover reveal; on touch it would stick after a tap. */
  @media (hover: hover) {
    .project__link:hover {
      .project__title {
        text-decoration-color: currentColor;
      }

      .project__arrow {
        color: var(--text-strong);
        transform: translate(2px, -2px);
      }

      .project__description {
        color: var(--text);
      }

      .project__thumb {
        filter: none;
        transform: scale(1.04);
      }
    }
  }
</style>
