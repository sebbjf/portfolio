---
import { Image } from "astro:assets";

interface Project {
  name: string;
  description: string;
  built_with: string[];
  url: string;
  image: string;
}

interface Props {
  projectData: Project;
}

const { projectData } = Astro.props;
---

<li class="project">
  <a class="project__link" href={projectData.url} target="_blank" rel="noopener noreferrer">
    <span class="project__media">
      <Image
        class="project__thumb"
        src={"/img/projects/" + projectData.image}
        alt=""
        width={400}
        height={250}
        loading="lazy"
        decoding="async"
      />
    </span>
    <div class="project__body">
      <h3 class="project__title">{projectData.name}</h3>
      <p class="project__description">{projectData.description}</p>
      <ul class="project__tags">
        {projectData.built_with.map((tech) => <li>{tech}</li>)}
      </ul>
    </div>
    <svg class="project__arrow" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</li>

<style>
  .project {
    border-bottom: 1px solid var(--border);
  }

  .project__link {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    gap: 28px;
    align-items: start;
    padding: 28px 4px;
    color: inherit;
    border-radius: var(--radius-sm);
  }

  .project__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    transition: border-color 0.3s var(--ease-out);
  }

  .project__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s var(--ease-out);
  }

  .project__title {
    margin: 0;
    font-size: 1.6rem;
    letter-spacing: -0.025em;
    color: var(--text-strong);
    transition:
      color 0.3s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .project__description {
    max-width: 52ch;
    margin: 6px 0 0;
    color: var(--text-muted);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 14px 0 0;
    font-size: 0.85rem;
    color: var(--text-subtle);

    & > li {
      text-transform: lowercase;
    }
  }

  .project__arrow {
    margin-top: 8px;
    color: var(--text-subtle);
    transition:
      color 0.3s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .project__link:hover,
  .project__link:focus-visible {
    .project__title {
      color: var(--accent);
      transform: translateX(6px);
    }

    .project__arrow {
      color: var(--accent);
      transform: translate(3px, -3px);
    }

    .project__media {
      border-color: var(--border-strong);
    }

    .project__thumb {
      transform: scale(1.05);
    }
  }

  .project__link:active .project__title {
    transform: translateX(4px);
  }

  @media only screen and (max-width: 768px) {
    .project__link {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 16px;
      padding: 22px 0;
    }

    .project__media {
      border-radius: var(--radius-sm);
    }

    .project__title {
      font-size: 1.35rem;
    }

    .project__arrow {
      display: none;
    }
  }
</style>
