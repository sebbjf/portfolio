---
import { useTranslations, localizePath } from "../utils/i18n";
import LanguageIcon from "../icons/language.astro";
import ArrowDown from "../icons/arrow-down.astro";

const t = useTranslations(Astro.currentLocale);

const { pathname } = Astro.url;
const languages = [
  { code: "en", label: "English" },
  { code: "es", label: "Español" },
];
---

<div class="lang__container">
  <button
    class="lang__button"
    id="lang-button"
    type="button"
    aria-label={t("a11y.changeLanguage")}
    aria-expanded="false"
    aria-controls="lang-menu"
  >
    <LanguageIcon />
    <ArrowDown />
  </button>
  <ul class="lang__options" id="lang-menu">
    {
      languages.map(({ code, label }) => (
        <li>
          <a
            href={localizePath(pathname, code)}
            hreflang={code}
            lang={code}
            aria-current={Astro.currentLocale === code ? "true" : undefined}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang__container {
    position: relative;
  }

  .lang__button {
    display: flex;
    align-items: center;
    padding: 4px 6px;
    color: var(--text-strong);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s var(--ease-out);

    &:hover,
    &[aria-expanded="true"] {
      background-color: var(--tint-hover);
    }

    &:active {
      background-color: var(--tint-active);
    }
  }

  .lang__options {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: var(--z-dropdown);
    min-width: 140px;
    margin: 0;
    padding: 6px;
    background-color: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);

    /* Grows out of the button it belongs to. It closes faster than it opens, and stays
       hidden from focus and clicks (visibility) once the fade-out ends. */
    visibility: hidden;
    opacity: 0;
    transform: scale(0.96);
    transform-origin: top right;
    transition:
      opacity 120ms var(--ease-out),
      transform 120ms var(--ease-out),
      visibility 0s linear 120ms;
  }

  /* "inherit", not "visible": inside the closed mobile menu the dropdown must hide with its parent. */
  .lang__options.lang__show {
    visibility: inherit;
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms var(--ease-out),
      transform 180ms var(--ease-out),
      visibility 0s;
  }

  .lang__options a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-strong);
    transition: background-color 0.2s var(--ease-out);

    &:hover,
    &:active {
      background-color: var(--surface-hover);
    }

    &[aria-current="true"] {
      color: var(--accent);
    }
  }

  @media (pointer: coarse) {
    .lang__button {
      min-height: var(--tap);
      padding-inline: 10px;
    }

    .lang__options a {
      display: flex;
      align-items: center;
      min-height: var(--tap);
    }
  }

  @media only screen and (max-width: 768px) {
    /* Centered under the button in the mobile menu, so it grows from the top center. */
    .lang__options {
      right: 50%;
      transform: translateX(50%) scale(0.96);
      transform-origin: top center;
    }

    .lang__options.lang__show {
      transform: translateX(50%);
    }
  }
</style>

<script>
  const button = document.getElementById("lang-button");
  const menu = document.getElementById("lang-menu");

  const setOpen = (open: boolean) => {
    menu.classList.toggle("lang__show", open);
    button.setAttribute("aria-expanded", String(open));
  };

  button.addEventListener("click", (e) => {
    e.stopPropagation();
    setOpen(!menu.classList.contains("lang__show"));
  });

  document.addEventListener("click", (e) => {
    if (!menu.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("lang__show")) {
      setOpen(false);
      button.focus();
    }
  });

  window.addEventListener("scroll", () => setOpen(false), { passive: true });
</script>
