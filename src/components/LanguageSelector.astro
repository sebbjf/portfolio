---
import i18next, { t } from "i18next";
import { localizePath } from "astro-i18next";
import LanguageIcon from "../icons/language.astro";
import ArrowDown from "../icons/arrow-down.astro";

const { pathname } = Astro.url;
const languages = [
  { code: "en", label: "English" },
  { code: "es", label: "Español" },
];
---

<div class="lang__container">
  <button
    class="lang__button"
    id="lang-button"
    type="button"
    aria-label={t("a11y.changeLanguage")}
    aria-expanded="false"
    aria-controls="lang-menu"
  >
    <LanguageIcon />
    <ArrowDown />
  </button>
  <ul class="lang__options" id="lang-menu">
    {
      languages.map(({ code, label }) => (
        <li>
          <a
            href={localizePath(pathname, code)}
            hreflang={code}
            lang={code}
            aria-current={i18next.language === code ? "true" : undefined}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang__container {
    position: relative;
  }

  .lang__button {
    display: flex;
    align-items: center;
    padding: 4px 6px;
    color: var(--text-strong);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s var(--ease-out);

    &:hover,
    &[aria-expanded="true"] {
      background-color: rgb(255 255 255 / 0.08);
    }
  }

  .lang__options {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: var(--z-dropdown);
    min-width: 140px;
    margin: 0;
    padding: 6px;
    background-color: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
    display: none;
  }

  .lang__options.lang__show {
    display: block;
  }

  .lang__options a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-strong);
    transition: background-color 0.2s var(--ease-out);

    &:hover {
      background-color: var(--surface-hover);
    }

    &[aria-current="true"] {
      color: var(--accent);
    }
  }

  @media only screen and (max-width: 768px) {
    .lang__options {
      right: 50%;
      transform: translateX(50%);
    }
  }
</style>

<script>
  const button = document.getElementById("lang-button");
  const menu = document.getElementById("lang-menu");

  const setOpen = (open: boolean) => {
    menu.classList.toggle("lang__show", open);
    button.setAttribute("aria-expanded", String(open));
  };

  button.addEventListener("click", (e) => {
    e.stopPropagation();
    setOpen(!menu.classList.contains("lang__show"));
  });

  document.addEventListener("click", (e) => {
    if (!menu.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("lang__show")) {
      setOpen(false);
      button.focus();
    }
  });

  window.addEventListener("scroll", () => setOpen(false), { passive: true });
</script>
