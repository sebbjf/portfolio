---
import "../styles/normalize.css";
import "../styles/styles.css";
import SEO from "../components/SEO.astro";
import { useTranslations } from "../utils/i18n";

const t = useTranslations(Astro.currentLocale);

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <SEO title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("a11y.skipToContent")}</a>
    <!-- Announced after the name of every link that opens a new tab (aria-describedby). -->
    <span id="new-tab-hint" class="visually-hidden">{t("a11y.newTab")}</span>
    <slot />
  </body>
</html>
